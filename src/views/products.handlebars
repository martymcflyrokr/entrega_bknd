<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Productos</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.7.2/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        .card {
            transition: transform 0.2s;
            margin-bottom: 20px;
        }
        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }
        .card-img-top {
            height: 200px;
            object-fit: cover;
        }
        .card-title {
            font-size: 1.1rem;
            font-weight: bold;
            margin-bottom: 0.5rem;
        }
        .card-text {
            color: #666;
        }
        .price {
            font-size: 1.2rem;
            color: #28a745;
            font-weight: bold;
        }
        .cart-button {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 1000;
        }
        .cart-count {
            position: absolute;
            top: -8px;
            right: -8px;
            background-color: #dc3545;
            color: white;
            border-radius: 50%;
            padding: 0.25rem 0.5rem;
            font-size: 0.75rem;
            font-weight: bold;
        }
    </style>
</head>
<body class="bg-light">
    <!-- Botón del carrito -->
    <a href="/carts/67e5b9e50625598bfeb52217" class="btn btn-primary cart-button">
        <i class="bi bi-cart3"></i>
        <span id="cartCount" class="cart-count">0</span>
    </a>

    <div class="container py-5">
        <h1 class="text-center mb-4">Nuestros Productos</h1>
        
        {{#if payload.length}}
            <div class="row row-cols-1 row-cols-md-3 g-4">
                {{#each payload}}
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm">
                        <img src="{{this.thumbnail}}" class="card-img-top" alt="{{this.title}}">
                        <div class="card-body">
                            <h5 class="card-title text-truncate">{{this.title}}</h5>
                            <p class="card-text price mb-2">${{this.price}}</p>
                            <p class="card-text"><small class="text-muted">Stock: {{this.stock}}</small></p>
                            <div class="d-flex justify-content-between mt-3">
                                <a href="/products/{{this._id}}" class="btn btn-outline-primary">Ver detalles</a>
                                <button onclick="addToCart('{{this._id}}')" class="btn btn-success">
                                    <i class="bi bi-cart-plus"></i> Agregar
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                {{/each}}
            </div>

            {{!-- Paginación --}}
            <nav aria-label="Page navigation" class="mt-5">
                <ul class="pagination justify-content-center">
                    {{#if hasPrevPage}}
                    <li class="page-item">
                        <a class="page-link" href="{{prevLink}}" aria-label="Previous">
                            <span aria-hidden="true">&laquo;</span>
                        </a>
                    </li>
                    {{/if}}
                    
                    <li class="page-item active">
                        <span class="page-link">Página {{page}} de {{totalPages}}</span>
                    </li>

                    {{#if hasNextPage}}
                    <li class="page-item">
                        <a class="page-link" href="{{nextLink}}" aria-label="Next">
                            <span aria-hidden="true">&raquo;</span>
                        </a>
                    </li>
                    {{/if}}
                </ul>
            </nav>
        {{else}}
            <div class="alert alert-info text-center">
                <i class="bi bi-exclamation-circle"></i> No hay productos disponibles en este momento.
            </div>
        {{/if}}
    </div>

    <!-- Bootstrap JS Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        let cartId = '67e5b9e50625598bfeb52217';

        // Función para inicializar el carrito
        async function initializeCart() {
            try {
                const response = await fetch('/api/carts', {
                    method: 'POST'
                });
                if (response.ok) {
                    const cart = await response.json();
                    cartId = cart._id;
                    updateCartCount();
                }
            } catch (error) {
                console.error('Error al inicializar el carrito:', error);
            }
        }

        // Función para actualizar el contador del carrito
        async function updateCartCount() {
            try {
                const response = await fetch('/api/carts/' + cartId);
                if (response.ok) {
                    const cart = await response.json();
                    const count = cart.products.reduce((total, item) => total + item.quantity, 0);
                    document.getElementById('cartCount').textContent = count;
                } else if (response.status === 404) {
                    // Si el carrito no existe, crear uno nuevo
                    await initializeCart();
                }
            } catch (error) {
                console.error('Error al obtener el carrito:', error);
            }
        }

        // Actualizar el contador al cargar la página
        updateCartCount();

        async function addToCart(productId) {
            try {
                const response = await fetch('/api/carts/' + cartId + '/products/' + productId, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });
                
                if (response.ok) {
                    // Actualizar el contador del carrito
                    updateCartCount();

                    const toast = document.createElement('div');
                    toast.className = 'position-fixed bottom-0 end-0 p-3';
                    toast.style.zIndex = '11';
                    toast.innerHTML = `
                        <div class="toast show bg-success text-white" role="alert" aria-live="assertive" aria-atomic="true">
                            <div class="toast-header">
                                <strong class="me-auto">Carrito</strong>
                                <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
                            </div>
                            <div class="toast-body">
                                Producto agregado al carrito exitosamente
                            </div>
                        </div>
                    `;
                    document.body.appendChild(toast);
                    setTimeout(() => toast.remove(), 3000);
                } else if (response.status === 404) {
                    // Si el carrito no existe, crear uno nuevo y reintentar
                    await initializeCart();
                    addToCart(productId);
                } else {
                    alert('Error al agregar el producto al carrito');
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Error al agregar el producto al carrito');
            }
        }
    </script>
</body>
</html> 