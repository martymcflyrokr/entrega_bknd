<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{product.title}} - Detalles</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-4">
        <div class="row">
            <div class="col-md-6">
                <img src="{{product.thumbnail}}" class="img-fluid rounded" alt="{{product.title}}">
            </div>
            <div class="col-md-6">
                <h1>{{product.title}}</h1>
                <p class="lead">{{product.description}}</p>
                <h2 class="text-primary">${{product.price}}</h2>
                <p>Stock disponible: {{product.stock}}</p>
                <p>Código: {{product.code}}</p>
                <button onclick="addToCart('{{product.id}}')" class="btn btn-success btn-lg">Agregar al carrito</button>
                <a href="/products" class="btn btn-secondary btn-lg">Volver a productos</a>
            </div>
        </div>
    </div>

    <script>
        async function addToCart(productId) {
            try {
                const response = await fetch('/api/carts/1/products/' + productId, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });
                
                if (response.ok) {
                    alert('Producto agregado al carrito');
                } else {
                    alert('Error al agregar el producto al carrito');
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Error al agregar el producto al carrito');
            }
        }
    </script>
</body>
</html> 